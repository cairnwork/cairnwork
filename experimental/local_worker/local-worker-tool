#!/bin/sh
# local-worker-tool: the one command the Owner may start as _cairnwork_worker for the local agent
# arm's tool calls (Cairnwork #88, isolation half). Installed by install_local_worker_tool.sh to
# /Users/Shared/cairnwork-worker/local-bin/local-worker-tool (root:wheel 0755, in a root-owned
# directory, so neither the Owner nor the worker can swap it); the sudoers rule
#   <owner> ALL=(_cairnwork_worker) NOPASSWD: /Users/Shared/cairnwork-worker/local-bin/local-worker-tool
# names that path. experimental/local_worker/tools.py runs it with `sudo -n -u _cairnwork_worker`.
#
# Eight actions, nothing else (exit 64 = refused before anything ran):
#   [--start-nonce <hex>] before the action prints LOCAL_WORKER_STARTED <hex> on stderr first.
#   local-worker-tool list   <run_root> <relpath>        list a directory of the checkout
#   local-worker-tool read   <run_root> <relpath>        print a regular file of the checkout
#   local-worker-tool write  <run_root> <relpath>        replace a checkout file with stdin
#   local-worker-tool pytest <run_root> [pytest args]    run <run_root>/venv/bin/python -m pytest
#   local-worker-tool sweep  <run_root>                  kill this run's worker processes
#   local-worker-tool status <run_root>                  git status of the checkout (porcelain v2,
#                                                        then empty directories, FIFOs, sockets)
#   local-worker-tool numstat <run_root>                 lines added/removed vs HEAD (PATCH line)
#   local-worker-tool tracked <run_root>                 every path (files and directories) of HEAD
#
# <run_root> is a canonical real directory directly inside $RUNS named by 32 lowercase hex digits,
# created by the Owner (0750: the worker may not rename or plant entries in it) together with
# <run_root>/checkout, <run_root>/tmp and <run_root>/q (0770). q is the git queries' scratch
# directory: only the query profile below can read or write it, so test code (which runs under the
# tool profile, as the same uid) cannot rewrite a query's output. <relpath> is relative to the
# checkout, with no "..", "." (except a bare "." for list), empty or ".git" (any case) component.
#
# Every action except sweep runs under a Seatbelt profile built HERE (never supplied by the caller).
# The tool profile (list, read, write, pytest):
#   * no network at all (the tools do not need it; Splash is the agent loop's business, not theirs);
#   * no reads under /Users, /Volumes, /private/tmp, /private/var/tmp, /private/var/folders except
#     this run's checkout, venv and tmp and the worker Python tree, so the owner's home, the
#     verifier tree, private test bundles, the harness and every other run (same uid!) are unreadable;
#   * writes only inside <run_root>/checkout and <run_root>/tmp, never into any .git component (a
#     worker-written hook or config would later run as the Owner), and nothing in <run_root>/q;
#   * signals only to processes in the same sandbox (not the agy worker's runs, which share the uid).
# The query profile (status, numstat, tracked): the same network, read and signal limits, reads
# of the checkout (its .git included) and <run_root>/q only, writes only inside <run_root>/q. No
# code the model wrote ever runs under it (git runs with no filter, hook, driver or textconv; see
# GIT_QUERY).
# The uid boundary (the account cannot enter /Users/<owner>) sits under this as a second layer.
#
# For tests and the pre-install canary the Owner may run this file directly (not through sudo) with
# CAIRNWORK_LOCAL_WORKER_RUNS / CAIRNWORK_LOCAL_WORKER_PYROOT set; running as the worker account,
# those overrides are ignored (sudo also resets the environment).
set -eu

WORKER=_cairnwork_worker
RUNS=/Users/Shared/cairnwork-worker/local-runs
PYROOT=/Users/Shared/cairnwork-worker/python
if [ "$(id -un)" != "$WORKER" ]; then
  RUNS=${CAIRNWORK_LOCAL_WORKER_RUNS:-$RUNS}
  PYROOT=${CAIRNWORK_LOCAL_WORKER_PYROOT:-$PYROOT}
fi
SANDBOX_EXEC=/usr/bin/sandbox-exec
WORKER_PATH=/usr/bin:/bin:/usr/sbin:/sbin
TAG_ENV=CAIRNWORK_LOCAL_RUN_TAG

refuse() {
  printf 'local-worker-tool: refusing: %s\n' "$*" >&2
  exit 64
}

physical_dir() {
  (CDPATH= cd -P -- "$1" 2>/dev/null && pwd -P)
}

# A path we splice into the profile must be absolute and free of quote/backslash/newline.
require_profile_safe() {
  case "$1" in
    /*) ;;
    *) refuse "$2 is not absolute" ;;
  esac
  case "$1" in
    *'"'* | *'\'* | *"
"*) refuse "$2 has a character the profile cannot carry" ;;
  esac
}

require_run_root() {
  require_profile_safe "$1" run_root
  [ ! -L "$1" ] && [ -d "$1" ] || refuse "run_root is not a real directory"
  [ "$(physical_dir "$1")" = "$1" ] || refuse "run_root is not a canonical path"
  [ "$(physical_dir "$RUNS")" = "$RUNS" ] || refuse "runs directory is not canonical"
  [ "${1%/*}" = "$RUNS" ] || refuse "run_root is not directly inside $RUNS"
  name=${1##*/}
  case "$name" in
    *[!0-9a-f]*) refuse "run_root name is not a run tag" ;;
  esac
  [ "${#name}" -eq 32 ] || refuse "run_root name is not a run tag"
  CHECKOUT=$1/checkout
  [ ! -L "$CHECKOUT" ] && [ -d "$CHECKOUT" ] || refuse "run_root has no real checkout directory"
  [ ! -L "$1/tmp" ] && [ -d "$1/tmp" ] || refuse "run_root has no real tmp directory"
  [ ! -L "$1/q" ] && [ -d "$1/q" ] || refuse "run_root has no real q directory"
  [ ! -w "$1" ] || [ "$(id -un)" != "$WORKER" ] || refuse "run_root is writable by the worker"
}

# relpath: relative, no empty / "." / ".." / ".git" component, no newline, not starting with "-".
require_relpath() {
  case "$1" in
    "" | /* | -*) refuse "path must be a non-empty relative path" ;;
    *"
"*) refuse "path has a newline" ;;
  esac
  case "/$1/" in
    *//* | */./* | */../* | */.[gG][iI][tT]/*) refuse "path has an empty, '.', '..' or '.git' component" ;;
  esac
}

# Directory $1 (absolute) must resolve inside the checkout.
require_dir_inside_checkout() {
  real=$(physical_dir "$1") || refuse "$2 directory cannot be resolved"
  case "$real/" in
    "$CHECKOUT"/*) ;;
    *) refuse "$2 resolves outside the checkout" ;;
  esac
  case "$real/" in
    */.[gG][iI][tT]/*) refuse "$2 resolves into a .git directory" ;;
  esac
}

ancestors() {   # SBPL literals for every ancestor directory of $1 (metadata only)
  p=$1
  while [ "$p" != "" ] && [ "$p" != "/" ]; do
    p=${p%/*}
    [ -n "$p" ] || p=/
    printf ' (literal "%s")' "$p"
  done
}

profile_head() {  # no network; no reads of the user, volume and temp trees (allowed back below)
  printf '(version 1)\n(allow default)\n(deny network*)\n'
  printf '(deny mach-lookup (global-name "com.apple.dnssd.service"))\n'
  printf '(deny file-read* (subpath "/Users") (subpath "/Volumes") (subpath "/private/tmp")'
  printf ' (subpath "/private/var/tmp") (subpath "/private/var/folders"))\n'
}

profile() {  # the tool profile: list, read, write, pytest (and so every line of test code)
  profile_head
  printf '(allow file-read* (subpath "%s") (subpath "%s/venv") (subpath "%s/tmp") (subpath "%s"))\n' \
    "$CHECKOUT" "$RUN_ROOT" "$RUN_ROOT" "$PYROOT"
  printf '(allow file-read-metadata%s%s)\n' "$(ancestors "$CHECKOUT")" "$(ancestors "$PYROOT")"
  printf '(deny file-write*)\n'
  printf '(allow file-write* (subpath "%s") (subpath "%s/tmp")' "$CHECKOUT" "$RUN_ROOT"
  printf ' (literal "/dev/null") (literal "/dev/tty") (literal "/dev/dtracehelper"))\n'
  printf '(deny file-write* (regex #"/\\.[gG][iI][tT](/|$)"))\n'
  printf '(deny file-read* file-write* (subpath "%s/q"))\n' "$RUN_ROOT"  # the queries' alone
  printf '(deny signal)\n(allow signal (target same-sandbox))\n'
}

query_profile() {  # the git queries: read the checkout (.git too) and q, write only inside q
  profile_head
  printf '(allow file-read* (subpath "%s") (subpath "%s/q"))\n' "$CHECKOUT" "$RUN_ROOT"
  printf '(allow file-read-metadata%s)\n' "$(ancestors "$CHECKOUT")"
  printf '(deny file-write*)\n'
  printf '(allow file-write* (subpath "%s/q") (literal "/dev/null"))\n' "$RUN_ROOT"
  printf '(deny signal)\n(allow signal (target same-sandbox))\n'
}

# sandboxed <profile text> <HOME and TMPDIR> <command...>
# The sandboxed command gets stdout AND stderr on the Owner's stdout (2>&1 below). Our own stderr,
# where the start marker went, is never handed to it: test code that lseeks/truncates fd 2 can then
# only damage its own output, not the Owner's proof that this wrapper started.
sandboxed() {
  sb_profile=$1
  sb_tmp=$2
  shift 2
  cd -- "$CHECKOUT"
  exec /usr/bin/env -i \
    HOME="$sb_tmp" \
    TMPDIR="$sb_tmp" \
    PATH="$WORKER_PATH" \
    LANG=en_US.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    "$TAG_ENV=${RUN_ROOT##*/}" \
    "$SANDBOX_EXEC" -p "$sb_profile" "$@" 2>&1
}

# The three fixed git queries (status, numstat, tracked): read-only on the checkout and .git, as the
# worker under the query profile, with TMPDIR=<run_root>/q (Claude review of #239, NB1: under the
# tool profile, test code left running by a pytest call could rewrite the query's output files). Git
# runs on a throwaway git dir in a fresh mktemp directory (Codex review of #239, B2 and the filter
# item): its HEAD is the real HEAD commit, the real objects are only an alternate, its config is two
# lines written here (so no repository config applies: no filter, include, driver or hook from
# .git/config), its info/attributes switches every filter and conversion off, and it copies the real
# info/exclude. No system or global config either; HOME and XDG_CONFIG_HOME are /var/empty
# (root-owned); core.attributesFile and core.excludesFile are /dev/null; no fsmonitor, untracked
# cache, hooks, optional index locks, external diff or textconv. The worker CAN write the worktree's
# .gitattributes and .gitignore: attributes come from the empty tree (--attr-source) and the
# overlay, so no .gitattributes can filter, convert or binarise anything, and numstat stages with
# --force (ignored files count) into a fresh index read from HEAD and counts the lines of the --text
# patch (PATCH_COUNT); those two files are still part of the change they make. status reads the real
# index; nothing in .git (nor anywhere in the checkout: the profile allows writes only in q) is ever
# written. Every file the query writes is new (mkdir without -p, noclobber), inside the mktemp
# directory. The real git binary is used, not the /usr/bin/git shim (its xcrun cache write outside
# the profile fails).
# shellcheck disable=SC2016  # expanded by the inner shell
GIT_QUERY='set -euf
c=$1
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_OPTIONAL_LOCKS=0 GIT_ATTR_NOSYSTEM=1
export GIT_TERMINAL_PROMPT=0 GIT_WORK_TREE="$c" GIT_CEILING_DIRECTORIES="${c%/*}"
export HOME=/var/empty XDG_CONFIG_HOME=/var/empty
G="$3 --attr-source=4b825dc642cb6eb9a060e54bf8d69288fbee4904 -c core.fsmonitor=false -c core.untrackedCache=false -c safe.directory=*
 -c core.hooksPath=/dev/null -c diff.external= -c core.quotePath=true
 -c core.attributesFile=/dev/null -c core.excludesFile=/dev/null"
q=$(/usr/bin/mktemp -d "$TMPDIR/gitq.XXXXXXXXXX")  # unpredictable, 0700, created atomically
trap '\''/bin/rm -rf "$q"'\'' EXIT
set -C  # noclobber: a redirection below never writes through an existing file
# Any git stderr (e.g. "could not open directory") or a nonzero exit fails the query (exit 3/4,
# the message printed instead of a result): the caller then treats the tree as not observed.
step() {
  /bin/rm -f "$q/out" "$q/err"
  "$@" >"$q/out" 2>"$q/err" || { /bin/cat "$q/err"; exit 3; }
  [ ! -s "$q/err" ] || { /bin/cat "$q/err"; exit 4; }
}
export GIT_DIR="$c/.git"  # only to name the HEAD commit (config is read; nothing there runs)
step $G rev-parse --verify --end-of-options "HEAD^{commit}"
h=$(/bin/cat "$q/out")
case ${#h}:$h in 40:*[!0-9a-f]* | 64:*[!0-9a-f]*) echo "bad HEAD"; exit 3 ;;
  40:* | 64:*) ;; *) echo "bad HEAD"; exit 3 ;; esac
o="$q/gitdir"
/bin/mkdir "$o" "$o/refs" "$o/info" "$o/objects" "$o/objects/info"
printf "%s\n" "$h" >"$o/HEAD"
if [ ${#h} = 64 ]; then
  printf "[core]\n\trepositoryformatversion = 1\n[extensions]\n\tobjectformat = sha256\n" >"$o/config"
else
  printf "[core]\n\trepositoryformatversion = 0\n" >"$o/config"
fi
printf "%s\n" "$c/.git/objects" >"$o/objects/info/alternates"
printf "* -filter -text -ident -working-tree-encoding\n" >"$o/info/attributes"
[ ! -f "$c/.git/info/exclude" ] || /bin/cat "$c/.git/info/exclude" >"$o/info/exclude"
export GIT_DIR="$o"
if [ "$2" = tracked ]; then  # the paths of HEAD, the base (Claude review of #239, NB4)
  step $G ls-tree -r -t -z --name-only --full-tree HEAD
  /bin/cat "$q/out"
  exit 0
fi
if [ "$2" = status ]; then
  export GIT_INDEX_FILE="$c/.git/index"
  step $G status --porcelain=v2 --branch -z -uall --renames --ignored=matching
  /bin/cat "$q/out"
  # What git cannot see (Claude review of #239, NB10): empty directories ("x d <path>") and
  # FIFOs or sockets ("x o <path>"), as extra NUL-terminated records after the porcelain ones.
  cd "$c"
  step /usr/bin/find . -path ./.git -prune -o -type d -empty -exec /usr/bin/printf "x d %s\0" {} +
  /bin/cat "$q/out"
  step /usr/bin/find . -path ./.git -prune -o \( -type p -o -type s \) \
    -exec /usr/bin/printf "x o %s\0" {} +
  /bin/cat "$q/out"
  exit 0
fi
export GIT_INDEX_FILE="$q/index"
step $G read-tree HEAD
step $G add -A --force
D="--cached --no-ext-diff --no-textconv --no-renames"
step $G diff $D --text -U0 HEAD
/bin/mv "$q/out" "$q/patch"
step $G diff $D --numstat HEAD
/bin/mv "$q/out" "$q/numstat"
step /usr/bin/env LC_ALL=C /usr/bin/awk "$4" "$q/patch" "$q/numstat"
/bin/cat "$q/out"'

# numstat's one line, "PATCH <added> <removed> <binary_files_changed>" (Claude review of #239,
# NB2: --text does not reach --numstat, which counts a file git takes for binary, e.g. one with a
# NUL byte, as "-" lines, so one NUL byte could hide a whole file's lines). Added and removed are
# the sums of the -U0 hunk headers of the --text patch, so every file's lines count, binary or
# not; binary_files_changed is how many files numstat itself would have shown as "-". Only the
# patch's hunk headers start with "@@" (content lines start with "+", "-", " " or "\"; the file
# header lines with fixed words), and a header without ",<count>" means one line.
# shellcheck disable=SC2016  # awk's own variables
PATCH_COUNT='FILENAME == ARGV[1] {
  if ($0 ~ /^@@ -/) {
    n = split($2, a, ","); r += (n > 1) ? a[2] : 1
    n = split($3, b, ","); d += (n > 1) ? b[2] : 1
  }
  next
}
/^-\t-\t/ { bin++ }
END { printf "PATCH %.0f %.0f %.0f\n", d, r, bin }'

real_git() {
  for g in /Library/Developer/CommandLineTools/usr/bin/git \
    /Applications/Xcode.app/Contents/Developer/usr/bin/git; do
    [ -x "$g" ] && { printf '%s\n' "$g"; return 0; }
  done
  refuse "no git binary under the developer tools"
}

# Worker-owned pids of this run: the run tag in their environment, or a cwd inside the run root.
# (A process that both clears its environment and leaves the run root is not found; it is still
# inside this run's Seatbelt profile, so the Owner must sweep before reading the checkout back and
# treat the checkout as untrusted.)
sweep_pids() {
  /bin/ps -E -ww -U "$UID_SELF" -o pid= -o command= 2>/dev/null | while read -r pid rest; do
    case " $rest " in
      *" $TAG_ENV=${RUN_ROOT##*/} "*) printf '%s\n' "$pid" ;;
    esac
  done
  /usr/sbin/lsof -nP -a -u "$UID_SELF" -d cwd -Fpn 2>/dev/null | while read -r line; do
    case "$line" in
      p*) pid=${line#p} ;;
      n"$RUN_ROOT" | n"$RUN_ROOT"/*) printf '%s\n' "$pid" ;;
    esac
  done
}

# Optional first option: --start-nonce <hex>. The Owner's tool layer passes a fresh nonce per call
# and treats "LOCAL_WORKER_STARTED <nonce>" as the first stderr line as the only proof that this
# wrapper started (sudo failures, exit 126/127 and model-written output cannot fake it).
if [ "${1:-}" = --start-nonce ]; then
  [ "$#" -ge 2 ] || refuse "--start-nonce needs a value"
  case "$2" in
    "" | *[!0-9a-f]*) refuse "start nonce must be lowercase hex" ;;
  esac
  printf 'LOCAL_WORKER_STARTED %s\n' "$2" >&2
  shift 2
fi

[ "$#" -ge 2 ] || refuse "usage: local-worker-tool <list|read|write|pytest|sweep|status|numstat|tracked> <run_root> ..."
ACTION=$1
RUN_ROOT=$2
shift 2
require_run_root "$RUN_ROOT"
require_profile_safe "$PYROOT" python_root
umask 007

case "$ACTION" in
  list | read | write)
    [ "$#" -eq 1 ] || refuse "$ACTION takes exactly one path"
    if [ "$ACTION" = list ] && [ "$1" = . ]; then
      TARGET=$CHECKOUT
    else
      require_relpath "$1"
      TARGET=$CHECKOUT/$1
    fi
    ;;
  pytest)
    PY=$RUN_ROOT/venv/bin/python
    [ -x "$PY" ] || refuse "run_root has no venv/bin/python"
    ;;
  sweep)
    [ "$#" -eq 0 ] || refuse "sweep takes no further arguments"
    ;;
  status | numstat | tracked)
    [ "$#" -eq 0 ] || refuse "$ACTION takes no further arguments"
    [ ! -L "$CHECKOUT/.git" ] && [ -d "$CHECKOUT/.git" ] || refuse "checkout has no real .git directory"
    ;;
  *) refuse "unknown action '$ACTION'" ;;
esac

case "$ACTION" in
  list)
    [ ! -L "$TARGET" ] && [ -d "$TARGET" ] || refuse "not a directory: $1"
    require_dir_inside_checkout "$TARGET" list
    sandboxed "$(profile)" "$RUN_ROOT/tmp" /bin/ls -1Ap -- "$TARGET"
    ;;
  read)
    [ ! -L "$TARGET" ] && [ -f "$TARGET" ] || refuse "not a regular file: $1"
    require_dir_inside_checkout "${TARGET%/*}" read
    sandboxed "$(profile)" "$RUN_ROOT/tmp" /bin/cat -- "$TARGET"
    ;;
  write)
    [ ! -L "$TARGET" ] || refuse "target is a symlink: $1"
    [ ! -e "$TARGET" ] || [ -f "$TARGET" ] || refuse "target exists and is not a regular file: $1"
    parent=${TARGET%/*}
    # Every existing ancestor up to the checkout must resolve inside it (no symlinked directory).
    probe=$parent
    while [ ! -d "$probe" ]; do probe=${probe%/*}; done
    require_dir_inside_checkout "$probe" write
    sandboxed "$(profile)" "$RUN_ROOT/tmp" /bin/sh -c 'mkdir -p -- "$1" && cat > "$2"' sh \
      "$parent" "$TARGET"
    ;;
  pytest)
    sandboxed "$(profile)" "$RUN_ROOT/tmp" "$PY" -m pytest -p no:cacheprovider "$@"
    ;;
  status | numstat | tracked)
    GIT_BIN=$(real_git) || exit 64
    sandboxed "$(query_profile)" "$RUN_ROOT/q" /bin/sh -c "$GIT_QUERY" sh "$CHECKOUT" "$ACTION" \
      "$GIT_BIN" "$PATCH_COUNT"
    ;;
  sweep)
    ME=$$
    UID_SELF=$(id -u)
    left=""
    for _ in 1 2 3 4 5; do
      left=""
      for p in $(sweep_pids); do
        [ "$p" = "$ME" ] && continue
        kill -9 "$p" 2>/dev/null && left="$left $p"
      done
      [ -z "$left" ] && break
      sleep 0.2
    done
    if [ -n "$left" ]; then
      printf 'LOCAL_WORKER_SWEEP unclean%s\n' "$left"
      exit 3
    fi
    printf 'LOCAL_WORKER_SWEEP clean\n'
    ;;
esac
